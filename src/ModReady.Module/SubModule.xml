<?xml version="1.0" encoding="UTF-8"?>
<Module xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/BUTR/Bannerlord.XmlSchemas/master/SubModule.xsd">
  <Id value="ModReady" />
  <Name value="ModReady" />
  <Version value="v2.0.0" />
  <DefaultModule value="false" />
  <ModuleCategory value="Singleplayer" />
  <ModuleType value="Community" />
  <Url value="https://www.nexusmods.com/mountandblade2bannerlord/mods/11274" />
  <!-- v2.0: ModReady is a standalone add-on that runs on top of BUTR's own
       Bannerlord.Harmony (which supplies 0Harmony at runtime). It ships no
       Bannerlord.* modules or BUTR-named assemblies of its own. -->
  <DependedModules>
    <DependedModule Id="Bannerlord.Harmony" DependentVersion="v2.4.2" />
  </DependedModules>

  <!-- ModReady's load guards (SubModuleConstructionGuard, CollectAssemblyTypesShim,
       ContinueLoadGuard) must be installed before the TaleWorlds stack and the
       community mods below construct, so they load after this module. -->
  <ModulesToLoadAfterThis>
    <!-- TaleWorlds stack -->
    <Module Id="Native" />
    <Module Id="SandBoxCore" />
    <Module Id="Sandbox" />
    <Module Id="StoryMode" />
    <Module Id="CustomBattle" />
    <!-- Community mods ModReady's load guards must construct ahead of. -->
    <Module Id="DismembermentPlus" />
    <Module Id="XorberaxLegacy" />
    <Module Id="DynaCulture" />
    <Module Id="ArtemsLivelyAnimations" />
    <!-- Pinning order here costs nothing if they're not installed - the
         launcher just ignores unknown Ids. -->
    <Module Id="FluidCombatLite" />
    <Module Id="Fluid_Combat_Lite" />
    <Module Id="BetterSmithing" />
    <Module Id="FasterTime" />
    <Module Id="BanditBlackHole" />
    <Module Id="PerfectFireArrows" />
    <Module Id="IDontCare" />
    <Module Id="ImprovedGarrisons" />
    <Module Id="DistinguishedService" />
    <Module Id="CulturedStartV2" />
    <Module Id="DiplomacyFixes" />
    <Module Id="Diplomacy" />
    <Module Id="CalradiaExpanded" />
    <Module Id="CalradiaExpandedKingdoms" />
    <Module Id="CargoHolds" />
    <Module Id="CrashDoctor" />
    <Module Id="AchievementUnblocker" />
    <Module Id="CREST" />
    <Module Id="Crest" />
  </ModulesToLoadAfterThis>

  <DependedModuleMetadatas>
    <DependedModuleMetadata id="Bannerlord.Harmony" order="LoadBeforeThis" version="v2.4.2" />
  </DependedModuleMetadatas>

  <SubModules>
    <SubModule>
      <Name value="ModReady" />
      <DLLName value="ModReady.Harmony.dll" />
      <SubModuleClassType value="ModReady.Harmony.ModReadyHarmonySubModule" />
      <Assemblies>
        <Assembly value="ModReady.Foundation.dll" />
      </Assemblies>
      <Tags />
    </SubModule>
  </SubModules>
</Module>
